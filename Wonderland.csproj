<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>Wonderland</AssemblyName>
    <RootNamespace>Wonderland</RootNamespace>
    <Version>0.1.0</Version>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <!-- Every warning here is CS8600/2/3/4/18/25 - nullable-reference-type static analysis flagging
         patterns that already have a runtime null check (GetPrefab/GetComponent results, scanner
         fields set in OnWorldReady rather than the constructor). Not suppressed per-site with '?'
         everywhere since this is a mod, not a library with a public nullable contract to document. -->
    <NoWarn>CS8600;CS8602;CS8603;CS8604;CS8618;CS8625</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!--
    Game DLLs below point at the playtest/1.0 snapshot (build 23105022, GAME-SNAPSHOT-playtest-build23105022),
    not the stale pre-1.0 copy at libs-Tools root - Valheim 1.0 ships 2026-09-09 and every ZDO/field
    fact this rebuild relies on was verified against that build's decompile. See
    libs-Tools/REFERENCE-DLL-PROVENANCE.md. assembly_valheim needs Publicize=true because Container/
    Inventory/Smelter/Fireplace internals this mod touches directly (m_width, m_conversion, m_maxFuel,
    etc.) are private in the vanilla assembly.
  -->
  <ItemGroup>
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.1" PrivateAssets="all" />
    <Reference Include="0Harmony">
      <HintPath>..\libs-Tools\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>..\libs-Tools\BepInEx.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="assembly_valheim">
      <HintPath>..\libs-Tools\GAME-SNAPSHOT-playtest-build23105022\Valheim dedicated server linux\valheim_server_Data\Managed\assembly_valheim.dll</HintPath>
      <Publicize>true</Publicize>
      <Private>False</Private>
    </Reference>
    <Reference Include="assembly_utils">
      <HintPath>..\libs-Tools\GAME-SNAPSHOT-playtest-build23105022\Valheim dedicated server linux\valheim_server_Data\Managed\assembly_utils.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>..\libs-Tools\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\libs-Tools\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- ServerSync.cs's client-side config-mismatch popup touches TMP_Text/MaskableGraphic directly. -->
    <Reference Include="Unity.TextMeshPro">
      <HintPath>..\libs-Tools\Unity.TextMeshPro.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>..\libs-Tools\UnityEngine.UI.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <MakeDir Directories="$(ProjectDir)HexiumDist\plugins" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ProjectDir)HexiumDist\plugins" />
  </Target>

</Project>
